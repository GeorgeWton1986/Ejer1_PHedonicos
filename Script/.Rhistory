# Definir URL del archivo en GitHub
github_url <- "https://raw.githubusercontent.com/GeorgeWton1986/Ejer1_PHedonicos/refs/heads/main/Data/Precio.dta"
# Leer el archivo .dta directamente desde GitHub
Precio_0 <- read_dta(github_url)
View(Precio_0)
numero_tabla <- 1  # Número de la tabla
# Crear tabla LaTeX con escape
tabla_latex_1 <- kable(head(Precio_0, 5),
format = "latex",
booktabs = TRUE,
caption = "Primeros 5 registros de la base de datos",
digits = 2,
escape = TRUE)
# Guardar la tabla en un archivo
writeLines(as.character(tabla_latex_1), file.path(dir_tablas, "tabla_temp.tex"))
#Convertir la tabla de resultados en Latex y PNG.
# Leer el contenido de la tabla
tabla_contenido <- readLines(file.path(dir_tablas, "tabla_temp.tex"))
# Extraer SOLO el contenido entre \begin{document} y \end{document}
inicio <- which(grepl("\\\\begin\\{document\\}", tabla_contenido))
fin <- which(grepl("\\\\end\\{document\\}", tabla_contenido))
if (length(inicio) > 0 && length(fin) > 0) {
# Extraer solo el contenido de la tabla (sin document tags)
tabla_limpia <- tabla_contenido[(inicio + 1):(fin - 1)]
} else {
# Si no hay \begin{document}, usar todo el contenido
tabla_limpia <- tabla_contenido
}
# Remover \begin{table} y \end{table} duplicados si existen
tabla_limpia <- tabla_limpia[!grepl("^\\\\begin\\{table\\}|^\\\\end\\{table\\}|^\\\\centering$", tabla_limpia)]
# Crear documento completo
doc_completo <- c(
"\\documentclass[12pt]{article}",
"\\usepackage{booktabs}",
"\\usepackage{caption}",
"\\usepackage{threeparttable}",
"\\usepackage{dcolumn}",
"\\usepackage{adjustbox}",
"\\usepackage{longtable}",
"\\usepackage{array}",
"\\usepackage[utf8]{inputenc}",
"\\usepackage[margin=0.5in, paperwidth=14in, paperheight=10in]{geometry}",
"\\pagestyle{empty}",
"\\begin{document}",
paste0("\\setcounter{table}{", numero_tabla - 1, "}"),
"\\begin{table}[htbp]",
"\\centering",
"\\footnotesize",
tabla_limpia,
"\\end{table}",
"\\end{document}"
)
# Guardar UN SOLO archivo .tex
writeLines(doc_completo, file.path(dir_tablas, "registros.tex"))
cat("✓ Archivo .tex guardado\n")
# Compilar
dir_actual <- getwd()
setwd(dir_tablas)
resultado <- try({
tinytex::pdflatex("registros.tex")
}, silent = FALSE)
setwd(dir_actual)
if (inherits(resultado, "try-error")) {
cat("\n❌ Error al compilar. Mostrando las últimas líneas del log:\n")
log_file <- file.path(dir_tablas, "registros.log")
if (file.exists(log_file)) {
log_lines <- readLines(log_file)
cat(tail(log_lines, 30), sep = "\n")
}
stop("No se pudo compilar el documento LaTeX")
}
# Verificar la ruta correcta del PDF
pdf_path <- file.path(dir_tablas, "registros.pdf")
if (file.exists(pdf_path)) {
# Convertir a PNG
img <- image_read_pdf(pdf_path, density = 300)
image_write(img, file.path(dir_tablas, "registros.png"))
cat(paste0("✓ Tabla ", numero_tabla, " convertida a PNG: ",
file.path(dir_tablas, "registros.png"), "\n"))
# Limpiar archivos temporales
archivos_temp <- c(
file.path(dir_tablas, "tabla_temp.tex"),
file.path(dir_tablas, "registros.pdf"),
file.path(dir_tablas, "registros.aux"),
file.path(dir_tablas, "registros.log")
)
file.remove(archivos_temp[file.exists(archivos_temp)])
cat("✓ Archivos temporales eliminados\n")
} else {
cat("❌ No se generó el PDF\n")
cat("Ruta buscada:", pdf_path, "\n")
# Verificar qué archivos se crearon
cat("Archivos en", dir_tablas, ":\n")
print(list.files(dir_tablas))
}
cat("✓ Tabla 1 guardada: primeros 5 registros\n")
View(Precio_0)
# Calcular estadísticas
stats <- Precio_0 %>%
summarise(across(everything(),
list(Media = mean,
SD = sd,
Min = min,
Max = max))) %>%
pivot_longer(everything()) %>%
separate(name, into = c("Variable", "Estadística"), sep = "_") %>%
pivot_wider(names_from = Estadística, values_from = value)
# Crear tabla
kable(stats, format = "latex", booktabs = TRUE, digits = 2) %>%
writeLines(file.path(dir_tablas, "stats_descriptivas.tex"))
# Calcular estadísticas descriptivas
stats_desc <- Precio_0 %>%
summarise(across(everything(),
list(N = ~n(),
Media = ~mean(., na.rm = TRUE),
SD = ~sd(., na.rm = TRUE),
Min = ~min(., na.rm = TRUE),
Max = ~max(., na.rm = TRUE)))) %>%
pivot_longer(everything()) %>%
separate(name, into = c("Variable", "Estadística"), sep = "_") %>%
pivot_wider(names_from = Estadística, values_from = value)
# Crear tabla LaTeX
tabla_latex <- kable(stats_desc,
format = "latex",
booktabs = TRUE,
digits = 2,
caption = "Estadísticas Descriptivas - Variables del Modelo Hedónico",
col.names = c("Variable", "N", "Media", "Desv. Est.", "Mínimo", "Máximo"))
# Guardar .tex
writeLines(as.character(tabla_latex), file.path(dir_tablas, "stats_descriptivas.tex"))
# Crear documento completo para compilar
doc_completo <- c(
"\\documentclass[12pt]{article}",
"\\usepackage{booktabs}",
"\\usepackage{longtable}",
"\\usepackage[utf8]{inputenc}",
"\\usepackage[margin=1in]{geometry}",
"\\begin{document}",
as.character(tabla_latex),
"\\end{document}"
)
# Guardar y compilar
writeLines(doc_completo, file.path(dir_tablas, "stats_descriptivas_full.tex"))
# Compilar a PDF
setwd(dir_tablas)
tinytex::pdflatex("stats_descriptivas_full.tex")
setwd("..")
# Convertir a PNG
img <- image_read_pdf(file.path(dir_tablas, "stats_descriptivas_full.pdf"), density = 300)
tinytex::install_tinytex()
