# Verificar directorio actual
getwd()
# Cambiar el directorio un nivel arriba
setwd("..")
# Verrificar el cambio en el directorio
getwd()
# Crear las carpetas
carpetas <- c("Tables", "Graphs")
for (carpeta in carpetas) {
if (!dir.exists(carpeta)) {
dir.create(carpeta)
cat("✓ Carpeta creada:", carpeta, "\n")
} else {
cat("✓ Carpeta ya existe:", carpeta, "\n")
}
}
# Crear un archivo .gitkeep
for (carpeta in carpetas) {
archivo_gitkeep <- file.path(carpeta, ".gitkeep")
if (!file.exists(archivo_gitkeep)) {
file.create(archivo_gitkeep)
cat("✓ Archivo .gitkeep creado en:", carpeta, "\n")
}
}
cat("\n✓ Carpetas creadas. Ahora ejecuta los siguientes comandos en la terminal:\n")
cat("git add .\n")
cat("git commit -m 'Crear estructura de carpetas del proyecto'\n")
cat("git push origin main\n")
# Verrificar el cambio en el directorio
getwd()
dir_tablas <- "../Tables"
dir_graficos <- "../Graphs"
